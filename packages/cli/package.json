{
  "name": "@folio/cli",
  "type": "module",
  "version": "0.1.0",
  "description": "Folio CLI — architectural intent validation for CI pipelines and local development",
  "author": "Ivanovic Nosel",
  "license": "CC-BY-4.0",
  "bin": {
    "folio": "./dist/bin/folio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@folio/core": "workspace:*",
    "@anthropic-ai/sdk": "^0.96.0",
    "commander": "^12.1.0",
    "picocolors": "^1.0.1",
    "js-yaml": "^4.1.0",
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12"
  }
}
